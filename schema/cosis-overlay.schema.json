{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bsommers/security-controls/schema/cosis-overlay.schema.json",
  "title": "NistCosisUseCaseOverlayV2",
  "type": "object",
  "required": [
    "overlay_id",
    "use_case_id",
    "title",
    "source_url",
    "provenance_tier",
    "source_provenance",
    "default_baseline",
    "cia_focus",
    "primary_risks",
    "tailored_controls"
  ],
  "additionalProperties": false,
  "properties": {
    "overlay_id": { "type": "string", "pattern": "^COSIS-[A-Z-]+$" },
    "use_case_id": {
      "type": "string",
      "enum": ["UC-GEN", "UC-PRED", "UC-AGENT-SINGLE", "UC-AGENT-MULTI", "UC-DEV"]
    },
    "title": { "type": "string", "minLength": 10 },
    "source_url": { "type": "string", "const": "https://csrc.nist.gov/projects/cosis/use-cases" },
    "provenance_tier": { "type": "string", "const": "nist_cosis_use_case_overlay" },
    "source_provenance": {
      "type": "object",
      "required": ["upstream_cosis_source", "organization_tailoring"],
      "additionalProperties": false,
      "properties": {
        "upstream_cosis_source": {
          "type": "object",
          "required": ["publication_status", "csrc_project_url", "use_case_designation"],
          "additionalProperties": false,
          "properties": {
            "publication_status": { "type": "string", "const": "[NIST-DRAFT]" },
            "csrc_project_url": { "type": "string", "const": "https://csrc.nist.gov/projects/cosis/use-cases" },
            "use_case_designation": { "type": "string", "minLength": 10 }
          }
        },
        "organization_tailoring": {
          "type": "object",
          "required": ["authority_id", "pattern_catalog_url", "scope_note"],
          "additionalProperties": false,
          "properties": {
            "authority_id": { "type": "string", "const": "bsommers/secure-design-patterns@MCP-2026-07-28" },
            "pattern_catalog_url": { "type": "string", "const": "https://github.com/bsommers/secure-design-patterns/blob/main/patterns/mcp-serve/catalog.json" },
            "scope_note": { "type": "string", "minLength": 15 }
          }
        }
      }
    },
    "default_baseline": { "type": "string", "enum": ["low", "moderate", "high"] },
    "cia_focus": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["confidentiality", "integrity", "availability", "privacy"] }
    },
    "primary_risks": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 10 }
    },
    "tailored_controls": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "control_id",
          "overlay_priority",
          "source_tier",
          "ai_tailoring_guidance",
          "parameter_assignments",
          "assessment_check",
          "pattern_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "control_id": { "type": "string", "pattern": "^[A-Z]{2}-\\d+(\\(\\d+\\))?$" },
          "overlay_priority": { "type": "string", "enum": ["P1", "P2"] },
          "source_tier": {
            "type": "string",
            "enum": ["nist_sp800_53b", "nist_cosis_draft", "org_pattern_tailoring"]
          },
          "ai_tailoring_guidance": { "type": "string", "minLength": 20 },
          "parameter_assignments": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "assessment_check": { "type": "string", "minLength": 15 },
          "pattern_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^MCP-\\d{3}$" }
          }
        }
      }
    }
  }
}
