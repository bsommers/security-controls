{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bsommers/security-controls/schema/cosis-overlay.schema.json",
  "title": "NistCosisUseCaseOverlay",
  "type": "object",
  "required": [
    "overlay_id",
    "use_case_id",
    "title",
    "source_url",
    "provenance_tier",
    "default_baseline",
    "cia_focus",
    "primary_risks",
    "tailored_controls"
  ],
  "additionalProperties": false,
  "properties": {
    "overlay_id": { "type": "string", "pattern": "^COSIS-[A-Z-]+$" },
    "use_case_id": {
      "type": "string",
      "enum": ["UC-GEN", "UC-PRED", "UC-AGENT-SINGLE", "UC-AGENT-MULTI", "UC-DEV"]
    },
    "title": { "type": "string", "minLength": 10 },
    "source_url": { "type": "string", "const": "https://csrc.nist.gov/projects/cosis/use-cases" },
    "provenance_tier": { "type": "string", "const": "nist_cosis_use_case_overlay" },
    "default_baseline": { "type": "string", "enum": ["low", "moderate", "high"] },
    "cia_focus": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["confidentiality", "integrity", "availability", "privacy"] }
    },
    "primary_risks": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 10 }
    },
    "tailored_controls": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "control_id",
          "overlay_priority",
          "ai_tailoring_guidance",
          "parameter_assignments",
          "assessment_check",
          "pattern_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "control_id": { "type": "string", "pattern": "^[A-Z]{2}-\\d+(\\(\\d+\\))?$" },
          "overlay_priority": { "type": "string", "enum": ["P1", "P2"] },
          "ai_tailoring_guidance": { "type": "string", "minLength": 20 },
          "parameter_assignments": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "assessment_check": { "type": "string", "minLength": 15 },
          "pattern_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^MCP-\\d{3}$" }
          }
        }
      }
    }
  }
}
